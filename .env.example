# LLM provider: openai | anthropic | local
# "local" parses native PDF text / OCR without an API call.
# If no API key is present, the app automatically falls back to local.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=60

# Open PO CSV has no currency column. Treat Beacon PO prices as this currency.
BASE_CURRENCY=USD
